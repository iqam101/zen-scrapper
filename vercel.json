{
  "version": 2,
  "name": "zen-scrapper",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/dashboard.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS,DELETE,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, apikey" }
      ]
    }
  ]
}
