{
  "manifest_version": 3,
  "name": "Zen Scrapper - GMB Lead Scraper & Outreach Engine",
  "version": "2.0.0",
  "author": "Iqam Ifthikar",
  "description": "Zen Scrapper by Iqam Ifthikar: Scrape Google My Business leads, run Deep Search on Google for missing websites & socials, audit website faults, and generate winning pitch angles.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zen Scrapper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*.google.com/maps/*",
    "*://*.google.co.uk/maps/*",
    "*://*.google.ca/maps/*",
    "*://*.google.com.au/maps/*",
    "*://*.google.com/search*",
    "*://*.google.co.uk/search*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/maps/*",
        "*://*.google.co.uk/maps/*",
        "*://*.google.ca/maps/*",
        "*://*.google.com.au/maps/*"
      ],
      "js": [
        "niche_classifier.js",
        "pitch_generator.js",
        "auditor.js",
        "content_gmaps.js"
      ],
      "css": [
        "content_gmaps.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
